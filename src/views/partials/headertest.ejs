<header class="site-header" role="banner">
    <section class="hero">
        <!-- Overlay -->
        <div class="hero__overlay"></div>

        <!-- Content -->
        <div class="hero__content" id="hero__content">
            <div class="header-container">

                <!-- Header Bar -->
                <div class="header-bar">

                    <!-- Logo -->
                    <a href="/">
                        <div class="logo-wrapper">
                            <img src="/images/logo/logo.png" alt="Bright Nursing Logo" class="site-logo" />
                        </div>
                    </a>

                    <!-- Navigation -->
                    <%- include("../partials/nav") %>
                </div>
            </div>
        </div>

        <div class="hero-image slider-wrapper">

            <% if (hero) { %>
            <% if (hero.type === "map") { %>
            <iframe src="<%= hero.mapSrc %>" width="1496" height="500" style="border:0;" allowfullscreen loading="lazy"
                referrerpolicy="no-referrer-when-downgrade">
            </iframe>
            <% } else if (hero.type === "image") { %>
            <!-- <div class="image-skeleton"></div> skeleton -->

            <% if (hero.type === "image") { %>
            <% hero.src.forEach((img, index) => { %>
            <img src="<%= img %>" alt="<%= hero.alt %>" class="slide <%= index === 0 ? 'active' : '' %>" loading="lazy"
                onload="this.classList.add('loaded')">
            <% }) %>
            <% } %>
            <% } %>
            <% } %>

            <div class="slider-controls">
                <button class="slider-btn left prevSlide">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>

                <button class="slider-btn right nextSlide">
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </div>

        <!-- Search Overlay -->
        <%- include("../partials/search-overlay") %>

        <!-- Hamburger/Mobile-Menu -->
        <%- include("../partials/mobile-menu") %>

    </section>

    <section class="admissions-open">
        <span id="admissions-open" class="address-full">ADMISSIONS OPEN FOR BSc. NURSING, PBBSc. NURSING, GNM, ANM,
            DMLT COURSES</span>
        <span class="address-short">ADMISSIONS OPEN FOR</span>
        <span class="address-short">BSc. NURSING, PBBSc. NURSING, GNM, ANM, DMLT COURSES</span>
    </section>
</header>