<header class="site-header" role="banner">
    <section class="hero">
        <!-- Overlay -->
        <div class="hero__overlay"></div>

        <!-- Content -->
        <div class="hero__content" id="hero__content">
            <div class="header-container">

                <!-- Header Bar -->
                <div class="header-bar">

                    <!-- Logo -->
                    <a href="/">
                        <div class="logo-wrapper">
                            <img src="/images/logo/logo.png" alt="Bright Nursing Logo" class="site-logo" />
                        </div>
                    </a>

                    <!-- Navigation -->
                    <%- include("../partials/nav") %>
                </div>
            </div>
        </div>

        <div class="hero-image">
            <% if (hero) { %>
            <% if (hero.type === "map") { %>
            <iframe src="<%= hero.mapSrc %>" width="1496" height="500" style="border:0;" allowfullscreen loading="lazy"
                referrerpolicy="no-referrer-when-downgrade">
            </iframe>
            <% } else if (hero.type === "image") { %>
            <img src="<%= hero.src %>" alt="<%= hero.alt %>">
            <% } %>
            <% } %>
        </div>

        <!-- Search Overlay -->
        <%- include("../partials/search-overlay") %>

        <!-- Hamburger/Mobile-Menu -->
        <%- include("../partials/mobile-menu") %>

    </section>

    <section class="admissions-open">
        <span id="admissions-open">ADMISSIONS OPEN FOR BSc. NURSING, PBBSc. NURSING, GNM, ANM, DMLT COURSES</span>
    </section>
</header>