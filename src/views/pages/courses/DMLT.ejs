                    <td>
                        PATHOLOGY – (Laboratory, Instruments, Safety & Clinical Haematology)
                    </td>
                    <td>60</td>
                    <td>40</td>
                    <td>100</td>
                </tr>

                <tr>
                    <td>PAPER 4</td>
                    <td>
