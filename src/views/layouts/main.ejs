<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title || "Bright College of Nursing - Admissions 2026" %></title>

    <meta name="description"
        content="Apply for B.Sc Nursing admissions at Bright College of Nursing. Modern labs and experienced faculty.">
    <meta name="keywords"
        content="nursing college, BSc nursing admissions, nursing college Odisha, nursing course Bhubaneswar">
    <meta property="og:title" content="Bright College of Nursing - Admissions 2026">
    <meta property="og:description" content="Apply now for nursing programs with modern labs and expert faculty.">
    <meta property="og:image" content="https://yoursite.com/images/og-image.jpg">
    <meta property="og:url" content="https://yoursite.com">

    <link rel="icon" href="/images/logo/favicon_io/favicon.ico" type="image/x-icon">

    <!-- Icons / Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Oriya:wght@400;600&display=swap" rel="stylesheet">

    <!-- Global Styles -->

    <link rel="stylesheet" href="/styles/output.css">
    <link rel="stylesheet" href="/styles/main.css">


    <!-- Page-specific styles-->
    <% if (typeof styles !== "undefined" && styles.length) { %>
    <% styles.forEach(style => { %>
    <link rel="stylesheet" href="<%= style %>">
    <% }) %>
    <% } %>

    <!-- Swiper.js -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
</head>

<body class="bg-[#FBF7EE]">

    <!-- Header / Navbar / Hero -->
    <%- include("../partials/headertest") %>

    <!-- Page Content -->
    <main>
        <%- body %>
    </main>

    <!--Enquiry form button-->
    <%- include("../partials/enquiry-form") %>

    <!--Go to Top button-->
    <%- include("../partials/gotoTop") %>

    <!-- Footer -->
    <%- include("../partials/footer") %>

    <!-- Global Animations / JS -->
    <script type="module" src="/main_anim.js"></script>

    <!-- Page-specific scripts -->
    <% if (scripts && scripts.length) { %>
    <% scripts.forEach(script => { %>
    <script src="<%= script %>"></script>
    <% }) %>
    <% } %>

</body>

</html>