<%- include("../../partials/breadcrumb-nav") %>

<section class="layout-container" id="anm">

    <!--Heading-->
    <div class="generic-heading__row">

        <h2>ANM at Bright School of Nursing</h2>

        <div class="__divider">
            <div class="__line"></div>
            <div class="__dot"></div>
        </div>
    </div>

    <div class="side-by-side">
        <div>
            <div class="section-heading__title">
                <h4>Program Overview</h4>
            </div>

            <p>
                ANM (Auxiliary Nursing & Midwifery) is a diploma-level nursing course designed to train students in
                basic
                healthcare, patient care, maternal care, Child Health and community health services.
            </p>

            <span>It is one of the best entry-level courses in the medical field, especially for students who want to
                start a
                nursing career quickly.
            </span>
        </div>
        <div>
            <img src="/images/Lab/Pre Clinical Science Lab.webp" loading="lazy" alt="Pre Clinical Science Lab"
                loading="lazy">
            <a href="/documents/Admission Form - (GNM & ANM).pdf" target="_blank">
                <p style="color: blue;text-align: center;font-size: 1.3rem;">
                    Download Admission Form</p>
            </a>
        </div>
    </div>


    <div class="grid">
        <!-- Recognized & approved by -->
        <div class="card full" style="gap: 100px;">
            <img src="/images/logo/ONMRC.png" loading="lazy"
                alt="Odisha Nurses &amp; Midwives Registration Council,Bhubaneswar (ONMRC)"
                style="width: auto; height: 100px;">
            <img src="/images/logo/onmeb.png" loading="lazy"
                alt="Odisha Nurses &amp; Midwives Examination Board (ONMEB)" style="width: auto; height: 100px;">
        </div>

        <!-- Duration -->
        <div class="card full">
            <div class="icon blue"><i class="fa-solid fa-calendar"></i></div>
            <div>
                <h3>Duration</h3>
                <p class="price">2 Years (including 6 Months Internship / Clinical Training)</p>
            </div>
        </div>

        <!-- Eligibility -->
        <div class="card full">
            <div class="icon green"><i class="fa-solid fa-check"></i></div>
            <div>
                <h3>Eligibility Criteria</h3>
                <p class="price">Passed 10+2 (Any Stream) from CHSE, CBSE, Sanskrit Board, NIOS or any other recognized
                    Board.
                </p>
                <p>
                    Only Female Candidates
                </p>
                <span>Age Limit: Minimum 17 years & Maximum 35 Years</span>
            </div>
        </div>

        <!-- Seats -->
        <div class="card">
            <div class="icon orange"><i class="fa-solid fa-chair"></i></div>
            <div>
                <h3>Seats</h3>
                <p class="price">40</p>
            </div>
        </div>

        <!-- Fees -->
        <div class="card">
            <div class="icon green"><i class="fa-solid fa-indian-rupee-sign"></i></div>
            <div>
                <h3>Course Fees</h3>
                <p class="price">₹50,000 / year</p>
            </div>
        </div>

        <!-- Mode of Selection -->
        <div class="card full">
            <div class="icon process"><i class="fa-solid fa-list-check"></i></div>
            <div style="width:100%">
                <h3>Mode of Selection</h3>
                <p class="price">Direct Admission at Institute under Management Quota or through ONMR&amp;C, Govt. of
                    Odisha
                    Online Counselling Process.
                </p>
            </div>
        </div>

        <!-- Hostel -->
        <div class="card full">
            <div class="icon blue"><i class="fa-solid fa-bed"></i></div>
            <div style="width:100%">
                <h3>Hostel Accommodation</h3>

                <div class="hostel-box">

                    <div class="sub-card">
                        <p class="price">₹2000 / month</p>
                        <p>Boarding only</p>
                    </div>

                    <div class="sub-card">
                        <p class="price">₹4000 / month</p>
                        <p>Boarding & Messing</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Amount to be deposited at the time of Admission -->
        <div class="card full">
            <div class="icon green"><i class="fa-solid fa-money-bill-wave"></i></div>
            <div style="width:100%">
                <h3>Amount to be deposited at the time of Admission</h3>

                <div class="hostel-box">

                    <div class="sub-card">
                        <h5>General / OBC Students</h5>
                        <p class="price">₹10000</p>
                        <p>Rest of the balance amount to be paid in Six Installments</p>
                    </div>

                    <div class="sub-card">
                        <h5>SC/ST Students</h5>
                        <p class="price">₹5000</p>
                        <p>Rest of the balance amount to be paid in Six Installments</p>
                    </div>
                </div>

            </div>
        </div>

        <!-- Scholarship -->
        <div class="card full">
            <div class="icon purple"><i class="fa-solid fa-graduation-cap"></i></div>
            <div style="width:100%">
                <h3>Scholarship Amount</h3>
                <p class="price">For Scholarship amount for SC, ST, OBC & General Students; for details, please
                    refer to
                    our <a href="/admissions/scholarship#scholarship" style="color: blue">Scholarship Page</a>.
                </p>
            </div>
        </div>
    </div>

    <h4>Why choose Bright School of Nursing for ANM Nursing?</h4>

