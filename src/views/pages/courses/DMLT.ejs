                    <td>60</td>
                    <td>40</td>
                    <td>100</td>
                </tr>

                <tr>
                    <td>PAPER 5</td>
                    <td>BIOCHEMISTRY</td>
                    <td>60</td>
                    <td>40</td>
                    <td>100</td>
                </tr>
            </tbody>
        </table>
