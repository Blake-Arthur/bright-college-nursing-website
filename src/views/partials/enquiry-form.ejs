<div id="modal-overlay" class="modal-overlay" aria-hidden="true">
    <div class="modal">

        <!-- HEADER -->
        <div class="modal-header">
            <img src="/images/logo/logo1.png" alt="Logo">
            <div>
                <h2>BRIGHT GROUP OF INSTITUTIONS</h2>
                <p class="subtext">
                    Recognized by the Odisha Nurses & Midwives Registration Council
                    (ONMRC),
                    and Affiliated to Odisha University of Health Sciences (OUHS)
                </p>
            </div>

            <!-- CLOSE BUTTON -->
            <button class="enquiry-close" data-enquiry-close>&times;</button>
        </div>

        <h3 class="form-title">Apply For Admission 2026&hyphen;27</h3>

        <hr>

        <!-- FORM -->
        <form id="form-grid" class="form-grid" method="POST" action="/api/enquiry">

            <!-- COURSE SECTION -->
            <div class="course-section">
                <p class="section-label">Course Applied For</p>

                <div class="course-row">
                    <img src="/images/logo/logo1.png">
                    <span>Bright College of Nursing</span>

                    <label>
                        <input type="radio" name="course" value="bsc" required> BSc. N
                    </label>

                    <label>
                        <input type="radio" name="course" value="pbbsc"> PBBSc. N
                    </label>
                </div>

                <div class="course-row">
                    <img src="/images/logo/logo1.png">
                    <span>Bright School of Nursing</span>

                    <label>
                        <input type="radio" name="course" value="gnm"> GNM
                    </label>

                    <label>
                        <input type="radio" name="course" value="anm"> ANM
                    </label>
                </div>

                <div class="course-row">
                    <img src="/images/logo/DMLT_logo.jpeg">
                    <span>Bright Institute of Medical Technology</span>

                    <label>
                        <input type="radio" name="course" value="dmlt"> DMLT
                    </label>
                </div>
            </div>

            <!-- FORM FIELDS -->
            <input type="text" name="name" placeholder="Student's Full Name" pattern="[a-zA-Z .]{3,100}" maxlength="100"
                minlength="3" required>

            <input type="tel" name="phone" inputmode="numeric" pattern="[6-9][0-9]{9}" maxlength="10" minlength="10"
                placeholder="Student Mobile No." required>

            <input type="tel" name="altPhone" inputmode="numeric" pattern="[6-9][0-9]{9}" maxlength="10" minlength="10"
                placeholder="Father / Guardian's Mobile No." required>

            <input type="email" name="email" pattern="[^\s@]+@[^\s@]+\.[^\s@]{2,}" maxlength="150"
                placeholder="Your E-Mail">

            <select name="district" id="districtSelect" required>
                <option value="">Select District</option>
            </select>

            <select name="city" id="citySelect" required>
                <option value="">Select City</option>
            </select>

            <div class="full-width">
                <label>Expected Date of Visit to College:</label>
                <input type="date" name="visitDate" min="<%= new Date().toISOString().split('T')[0] %>" required>
            </div>

            <div class="full-width">
                <label>Where did you hear about us?</label>
                <div class="radio-group">
                    <label>
                        <input type="radio" name="hearAbout" value="website" required>
                        Website
                    </label>

                    <label>
                        <input type="radio" name="hearAbout" value="ads">
                        Advertisement
                    </label>

                    <label>
                        <input type="radio" name="hearAbout" value="referral">
                        Friends &amp; Family
                    </label>

                    <label>
                        <input type="radio" name="hearAbout" value="social">
                        Social Media
                    </label>
                </div>
            </div>

            <button type="submit" class="submit-btn">Apply Now</button>
            <p id="formMessage" class="form-message"></p>
        </form>

    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", async function () {

        const districtSelect = document.getElementById("districtSelect");
        const citySelect = document.getElementById("citySelect");

        // Load districts
        const districtRes = await fetch("/api/districts");
        const districts = await districtRes.json();

        districts.forEach(d => {
            const option = document.createElement("option");
            option.value = d._id;
            option.textContent = d.name;
            districtSelect.appendChild(option);
        });

        // Load cities on district change
        districtSelect.addEventListener("change", async function () {

            citySelect.innerHTML = '<option value="">Select City</option>';

            if (!this.value) return;

            const cityRes = await fetch(`/api/cities/${this.value}`);
            const cities = await cityRes.json();

            cities.forEach(c => {
                const option = document.createElement("option");
                option.value = c._id;
                option.textContent = c.name;
                citySelect.appendChild(option);
            });
        });

    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("form-grid");
        if (!form) return;

        form.addEventListener("submit", async function (e) {
            e.preventDefault();

            const submitBtn = this.querySelector("button[type='submit']");
            const messageBox = document.getElementById("formMessage");
            console.log("MessageBox:", messageBox);

            submitBtn.disabled = true;
            submitBtn.textContent = "Submitting...";
            messageBox.textContent = "";

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch("/api/enquiry", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });

                let result;
                try {
                    result = await response.json();
                } catch {
                    result = { message: "Unexpected server response" };
                }

                if (!response.ok) throw new Error(result.message);

                messageBox.textContent = "Your Enquiry has been submitted successfully!\nYou will be notified soon.";
                messageBox.style.color = "green";
                this.reset();

            } catch (err) {
                messageBox.textContent = err.message || "Submission failed.";
                messageBox.style.color = "red";
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = "Apply Now";
            }
        });

    });
</script>