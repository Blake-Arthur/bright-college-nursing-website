                </div>
            </div>

            <!-- Eligibility -->
            <div class="card">
                <div class="icon green"><i class="fa-solid fa-check"></i></div>
                <div>
                    <h3>Eligibility Criteria</h3>
                    <p class="price">Passed 10+2 Science with aggregate 45% marks in PCB</p>
                    <span class="price">Age Limit: Minimum 17 years & Maximum 35 Years</span>
                </div>
            </div>

            <!-- Seats -->
            <div class="card">
                <div class="icon orange"><i class="fa-solid fa-chair"></i></div>
                <div>
