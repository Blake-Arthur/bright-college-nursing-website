<section class="flex  bg-[#293519] h-8 w-full pt-2">
    <div class="container">
        <ol class="breadcrumb">
            <% breadcrumbs.forEach((crumb, index) => { %>

            <li>
                <% if(crumb.url) { %>
                <a href="<%= crumb.url %>"><%= crumb.name %></a>
                <% } else { %>
                <span><%= crumb.name %></span>
                <% } %>
            </li>
            <% }) %>

        </ol>
    </div>
</section>