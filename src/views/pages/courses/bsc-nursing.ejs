                    <p class="price">₹70,000 / year</p>
                </div>
            </div>

            <!-- Mode of Selection -->
            <div class="card full">
                <div class="icon process"><i class="fa-solid fa-list-check"></i></div>
                <div style="width:100%">
                    <h3>Mode of Selection</h3>
                    <p class="price">Admission through OJEE Entrance Test. Direct Admission at Institute under
                        Management
                        Quota or through Govt. of Odisha Online Counselling Process.
                    </p>
                </div>
            </div>

            <!-- Hostel -->
            <div class="card full">
                <div class="icon blue"><i class="fa-solid fa-bed"></i></div>
                <div style="width:100%">
                    <h3>Hostel Accommodation</h3>

                    <div class="hostel-box">

                        <div class="sub-card">
                            <p class="price">₹2000 / month</p>
                            <span>Boarding only</span>
                        </div>

                        <div class="sub-card">
                            <p class="price">₹4000 / month</p>
                            <span>Boarding & Messing</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Amount to be deposited at the time of Admission -->
            <div class="card full">
                <div class="icon green"><i class="fa-solid fa-money-bill-wave"></i></div>
                <div style="width:100%">
                    <h3>Amount to be deposited at the time of Admission</h3>

                    <div class="hostel-box">

                        <div class="sub-card">
                            <h5>General / OBC Students</h5>
                            <p class="price">₹15000</p>
                            <p>Rest of the balance amount to be paid in Six Installments</p>
                        </div>

                        <div class="sub-card">
                            <h5>SC/ST Students</h5>
                            <p class="price">₹10000</p>
                            <p>Rest of the balance amount to be paid in Six Installments</p>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Scholarship -->
            <div class="card full">
                <div class="icon purple"><i class="fa-solid fa-graduation-cap"></i></div>
                <div style="width:100%">
                    <h3>Scholarship Amount</h3>
                    <p class="price">For Scholarship amount for SC, ST, OBC & General Students; for details, please
                        refer to
                        our <a href="/admissions/scholarship#scholarship" style="color: blue">Scholarship Page</a>.
                    </p>
                </div>
            </div>
        </div>

