<!--At a glance tab-->
<section class="layout-container">
    <div class="additional-info">
        <!-- Heading -->
        <div class="generic-heading__row ">
            <div class="__divider">
                <div class="__dot"></div>
                <div class="__line"></div>
            </div>

            <h2>Bright Group of Institutions</h2>

            <div class="__divider">
                <div class="__line"></div>
                <div class="__dot"></div>
            </div>
        </div>

        <h5>( Managed by Bright Educational Charitable Trust, Estd: 2007; Premier organisation in Odisha since 1986 )
        </h5>

        <section class="institutes-section side-by-side">

            <!-- LEFT SIDE -->
            <div class="institutes-list">

                <div class="institute-card">
                    <div class="card-header">
                        <img src="/images/logo/logo1.png" alt="Bright College of Nursing Logo">
                        <h4 style="color: var(--color-accent2);">Bright College of Nursing</h4>
                    </div>

                    <div class="card-courses">
                        <a href="/courses/bsc-nursing" class="course-pill">BSc Nursing</a>
                        <a href="/courses/pbbsc-nursing" class="course-pill">PBBSc Nursing</a>
                    </div>
                </div>

                <div class="institute-card">
                    <div class="card-header">
                        <img src="/images/logo/logo1.png" alt="Bright School of Nursing Logo">
                        <h4 style="color: var(--color-accent2);">Bright School of Nursing</h4>
                    </div>

                    <div class="card-courses">
                        <a href="/courses/GNM" class="course-pill">GNM</a>
                        <a href="/courses/ANM" class="course-pill">ANM</a>
                    </div>
                </div>

                <div class="institute-card">
                    <div class="card-header">
                        <img src="/images/logo/DMLT_logo.webp  " alt="Bright Institute of Medical Technology Logo">
                        <h4 style="color: var(--color-accent2);">Bright Institute of Medical Technology</h4>
                    </div>

                    <div class="card-courses">
                        <a href="/courses/DMLT" class="course-pill">DMLT</a>
                    </div>
                </div>

            </div>

            <!-- RIGHT SIDE -->
            <div class="institutes-image">
                <div class="slider-wrapper">

                    <% sliderimages.forEach((img, index) => { %>
                    <img src="<%= img.src %>" alt="<%= img.alt || 'slider image' %>"
                        class="slide <%= index === 0 ? 'active' : '' %>" loading="lazy">
                    <% }) %>

                    <div class="slider-controls">
                        <button class="slider-btn left prevSlide">
                            <i class="fa-solid fa-arrow-left"></i>
                        </button>

                        <button class="slider-btn right nextSlide">
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>

                </div>

                <div class="audio-card">
                    <div class="audio-controls">
                        <button class="play-btn">
                            <i class="fa-solid fa-play"></i>
                        </button>

                        <span class="current-time">00:00</span>

                        <input type="range" class="progress-bar" value="0" min="0" max="100">

                        <span class="duration">19:03</span>

                        <button class="volume-btn">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                    </div>

                    <audio id="collegeAudio" controls>
                        <source src="/documents/College Audio.mpeg" type="audio/mpeg">
                    </audio>
                </div>
            </div>

        </section>
    </div>
</section>

