        <div class="section-heading__title">
            <h4>Syllabus</h4>
        </div>

        <div class="table-wrapper">
            <table class="syllabus-table">
                <thead>
                    <tr>
                        <th colspan="2">First Year</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>Semester I</th>
                        <th>Semester II</th>
                    </tr>
                    <tr>
                        <th>1. General Science</th>
                        <th>1. Applied Biochemistry</th>
                    </tr>
                    <tr>
                        <th>2. Communicative English</th>
                        <th>2. Applied Nutrition and dietetics</th>
                    </tr>
                    <tr>
                        <th>3. Applied Anatomy & Physiology</th>
                        <th>3. Nursing Foundations II</th>
                    </tr>
                    <tr>
                        <th>4. Applied Sociology & Psychology </th>
                        <th>4. Introduction to Community Health Nursing</th>
                    </tr>
                    <tr>
                        <th>5. Nursing Foundations I</th>
                        <th></th>
                    </tr>
                </tbody>

                <thead>
                    <tr>
                        <th colspan="2">Second Year</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>Semester III</th>
                        <th>Semester IV</th>
                    </tr>
                    <tr>
                        <th>1. Applied Microbiology and Infection Control</th>
                        <th>1. Pharmacology II</th>
                    </tr>
                    <tr>
                        <th>2. Pharmacology I</th>
                        <th>2. Pathology II & Genetics</th>
                    </tr>
                    <tr>
                        <th>3. Pathology I</th>
                        <th>3. Adult Health Medical Surgical Nursing II</th>
                    </tr>
                    <tr>
                        <th>4. Adult Health (Medical-Surgical) Nursing I </th>
                        <th>4. Educational Technology / Nursing Education</th>
                    </tr>
                    <tr>
                        <th>5. Professionalism, Professional values & ethics </th>
                        <th></th>
                    </tr>
                </tbody>

                <thead>
                    <tr>
                        <th colspan="2">Third Year</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>Semester V</th>
                        <th>Semester VI</th>
                    </tr>
                    <tr>
                        <th>1. Child Health Nursing I</th>
                        <th>1. Child Health Nursing II</th>
                    </tr>
                    <tr>
                        <th>2. Mental Health Nursing I</th>
                        <th>2. Mental Health Nursing II</th>
                    </tr>
                    <tr>
                        <th>3. Nursing Management & Leadership</th>
                        <th>3. Community Health Nursing I</th>
                    </tr>
                    <tr>
                        <th>4. Nursing Research and Statistics </th>
                        <th>4. Midwifery/ Obstetrics and Gynaecology (OBG) Nursing I</th>
                    </tr>
                    <tr>
                        <th>5. Health/Nursing Informatics & technology</th>
                        <th></th>
                    </tr>
                    <tr>
                        <th>6. Introduction to Forensic Nursing & Indian Laws</th>
                        <th></th>
                    </tr>
                </tbody>

                <thead>
                    <tr>
                        <th colspan="2">Fourth Year</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>Semester VII</th>
                        <th>Semester VIII</th>
                    </tr>
                    <tr>
                        <th>1. Community Health Nursing II </th>
                        <th>1. Internship (Intensive practicum/Residency posting)</th>
                    </tr>
                    <tr>
                        <th>2. Midwifery/Obstetrics and Gynaecology (OBG) Nursing II</th>
                        <th></th>
                    </tr>
                </tbody>
            </table>
        </div>

