                            <a href="/courses/pbbsc-nursing">PBBSc. Nursing</a>
                        </span>
                    </div>
                </li>
                <li class="institute-card">
                    <div class="institute_card__description">
                        <!-- Logo -->
                        <a href="/">
                            <img src="/images/logo/logo1.png" loading="lazy" alt="Bright School of Nursing Logo" />
                        </a>
                        <h4 class="institute-card__title">Bright School of Nursing</h4>
                    </div>

                    <div class="institute-card__courses">
                        <span class="course-badge">
                            <a href="/courses/GNM">GNM</a>
                        </span>
                        <span class="course-badge">
                            <a href="/courses/ANM">ANM</a>
                        </span>
                    </div>
                </li>
                <li class="institute-card">
                    <div class="institute_card__description">
                        <!-- Logo -->
                        <a href="/">
                            <img src="/images/logo/DMLT_logo.jpeg" loading="lazy"
