<section class="scholarship-container" id="scholarship-mobile">

    <% scholarships.forEach(item => { %>

    <div class="scholarship-card">

        <input type="checkbox" id="<%= item.name %>" name="accordion">

        <div class="scholarship-title">
            <label for="<%= item.name %>"><%= item.name %></label>
            <i class="fa-solid fa-angle-down"></i>
        </div>

        <div class="scholarship-details">

            <div class="scholarship-row">
                <span class="label">Department</span>
                <span class="value"><%= item.department %></span>
            </div>


            <% if(item.eligibility){ %>
            <div class="scholarship-row">
                <span class="label">Eligibility</span>
                <span class="value"><%= item.eligibility %></span>
            </div>
            <% } %>


            <% if(item.documents && item.documents.length){ %>
            <div class="scholarship-row">
                <span class="label">Minimum Documents Required</span>

                <ol class="value">
                    <% item.documents.forEach(doc => { %>
                    <li><%= doc %></li>
                    <% }) %>
                </ol>

            </div>
            <% } %>


            <!-- COURSE AMOUNTS -->
            <% if(item.amount && item.amount.courses){ %>

            <div class="scholarship-row">
                <span class="label">Approximate Scholarship Amount</span>

                <ul class="value">
                    <% item.amount.courses.forEach(course => { %>
                    <li><strong><%= course.course %></strong> - <%= course.amount %></li>
                    <% }) %>
                </ul>

            </div>

            <% if(item.amount.note){ %>
            <p class="note"><%= item.amount.note %></p>
            <% } %>

            <% } else if(item.amount){ %>

            <div class="scholarship-row">
                <span class="label">Approximate Scholarship Amount</span>
                <span class="value"><%= item.amount %></span>
            </div>

            <% } %>


            <!-- CATEGORY BASED SCHOLARSHIPS -->
            <% if(item.categories){ %>

            <% item.categories.forEach(cat => { %>

            <div class="category-block">

                <h5 class="category-title"><%= cat.category %></h5>

                <% if(cat.eligibility){ %>
                <p><strong>Eligibility:</strong> <%= cat.eligibility %></p>
                <% } %>

                <% if(cat.documents && cat.documents.length){ %>

                <div class="scholarship-row">
                    <span class="label">Minimum Documents Required</span>

                    <ol>
                        <% cat.documents.forEach(doc => { %>
                        <li><%= doc %></li>
                        <% }) %>
                    </ol>
                </div>

                <% } %>

                <!-- COURSE AMOUNTS -->
                <div class="scholarship-row">
                    <span class="label">Approximate Scholarship Amount</span>

                    <% if(cat.courseAmounts){ %>

                    <ul>
                        <% cat.courseAmounts.forEach(c => { %>
                        <li><strong><%= c.course %></strong> - <%= c.amount %></li>
                        <% }) %>
                    </ul>

                    <% } else if(cat.amount){ %>

                    <span class="value"><%= cat.amount %></span>

                    <% } %>

                </div>

                <!-- MAINTENANCE ALLOWANCE TABLE -->
                <% if(cat.maintenanceAllowance){ %>

                <div class="table-wrapper">
                    <table>

                        <thead>
                            <tr>
                                <th rowspan="2">Group</th>
                                <th colspan="2">Scheduled Caste</th>
                                <th colspan="2">Scheduled Tribe</th>
                            </tr>

                            <tr>
                                <th>Hosteller</th>
                                <th>Day Scholar</th>
                                <th>Hosteller</th>
                                <th>Day Scholar</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% cat.maintenanceAllowance.forEach(row => { %>

                            <tr>
                                <td><%= row.group %></td>
                                <td><%= row.scHosteller %></td>
                                <td><%= row.scDayScholar %></td>
                                <td><%= row.stHosteller %></td>
                                <td><%= row.stDayScholar %></td>
                            </tr>

                            <% }) %>

                        </tbody>

                    </table>
                </div>

                <% } %>



            </div>

            <% }) %>

            <% } %>

            <% if(item.guideline){ %>

            <div class="scholarship-row">
                <span class="label">Guideline Document</span>

                <a href="<%= item.guideline %>" target="_blank">
                    <i class="fas fa-file-pdf fa-lg" style="color:#ff0000;"></i>
                </a>

            </div>

            <% } %>

        </div>

    </div>

    <% }) %>

</section>

<section class="layout-container">
    <section>
        <div class="section-heading__title">
            <h4>General Guidelines for Availing Scholarship</h4>
        </div>

        <ul class="li-bullet">
            <li>The student will apply online on the State Scholarship portal i.e. <a
                    href="https://scholarship.odisha.gov.in" target="_blank" rel="noopener noreferrer external"
                    style="color: blue;">https://scholarship.odisha.gov.in</a>.
            </li>
            <li>Students should Register at National Scholarship Portal <a href="https://scholarship.gov.in"
                    target="_blank" rel="noopener noreferrer external"
                    style="color: blue;">https://scholarship.gov.in</a> for <strong>OTR
                    (One Time
                    Registration)</strong> and
                <strong>eKYC by Face Authentication on NSP OTR App</strong> downloading from Play Store.
            </li>
            <li>The students must have an active and valid Bank account which is <strong>AADHAR Linked</strong>. The
                Scholarship amount shall
                be
                transferred by the Department to the beneficiary student Bank account directly through DBТ (Direct
                Benefit
                Transfer) mode.</li>
            <li>The scholarship sanctioned in favour of a student shall be <strong>liable for cancellation</strong> if
                he/she is found to
                have obtained the
                scholarship by <strong>false statements, discontinues his/her studies</strong>, or is in <strong>receipt
                    of
                    any other
                    scholarship.</strong>
            </li>
            <li>Students can't avail <strong>more than one scholarship</strong> for similar kind of courses.</li>
            <li>Student's undertaking to <strong>reimburse the amount to the College within 7 days</strong> after
                receipt of
                scholarship.
            </li>
            <li>Scholarship Amount mentioned above is for reference purpose of the students only. Students can get
                Scholarship amount
                by the concerned department of the Government depending upon their eligibility.</li>
            <li>Students should undergo details regarding the Scholarship Scheme, amount and eligibility from the Govt.
                sites before applying
                any of Scholarship. </li>
        </ul>
    </section>

    <section id="Krishi Vidya Nidhi Yojana">
        <div class="section-heading__title">
            <h4>Krishi Vidya Nidhi Yojana</h4>
        </div>

        <ul class="li-bullet">
            <li>Ration Card, Residence Certificate of the Student and CM-KISAN Id of the Parent
            </li>
            <li>To Check Parents CM-KISAN id for eligibility of <strong>Krishi Vidya Nidhi Yojana</strong> Scholarship
                Scheme on the portal
                i.e
                <a href="https://cmkisan.odisha.gov.in/" target="_blank" rel="noopener noreferrer external"
                    style="color: blue;">https://cmkisan.odisha.gov.in/</a>
                and under <strong>Beneficiary List</strong>, please check by mentioning <strong>District Name-
                    Block/Town
                    NameGP/ULB Name</strong>.
            </li>
        </ul>
    </section>

    <section id="Post Matric Scholarship">
        <div class="section-heading__title">
            <h4>Post Matric Scholarship</h4>
        </div>

        <ul class="li-bullet">
            <li>The Post-Matric Scholarship amount covers annual course fee comprising of Admission/ Re-admission fee,
                Tuition Fee, Exam
                fee and other compulsory non-refundable fees (such as Library/ sports/ cultural society/ magazine/
                social
                service/ union fee/
                computer/ internet fee/ laboratory fee etc.). The amount is paid annually to the eligible ST and SC
                students
                in their aadhaar
                seeded bank-account.
            </li>
            <li>Current Parents/ guardian's Annual INCOME Certificate and which shall not exceed <strong>Rs. 2.5 Lakhs
                    per
                    year</strong>.
            </li>
            <li>Recent Caste Certificate of the Student.</li>
            <li>In case of OBC/ SEBC and EBC students, Scholarship Award will be subject to at least 50% marks in last
                qualifying exam.
            </li>
        </ul>
    </section>

    <section id="Nirman Shramik Kalyan Yojana">
        <div class="section-heading__title">
            <h4>Nirman Shramik Kalyan Yojana</h4>
        </div>

        <p>Financial assistance to the eligible building and other construction worker for continuing education of their
            wards/ children under
            Nirman Shramik Kalyan Yojana by the Labour & ESI Department, Govt. of Odisha being extended by the Odisha
            building and Other
            Construction Workers Welfare Board.
        </p>

        <p>Students parents having NSKY Card for elgibility towards getting the Scholarship.
        </p>

        <span>For any query or help, students & other stakeholders may contact scholarship Sanjog Helpline 155335,
            1800-345-6770 or E-mail to
            <a href="scholarshiplabour@gmail.com" target="_blank" rel="noopener noreferrer external"
                style="color: blue;">scholarshiplabour@gmail.com
            </a>
        </span>
    </section>

    <section id="Azim Premji Scholarship">
        <div class="section-heading__title">
            <h4>Azim Premji Scholarship</h4>
        </div>

        <p>
            For more details visit their website
            <a href="https://azimpremjifoundation.org/" target="_blank" rel="noopener noreferrer external"
                style="color: blue;">
                https://azimpremjifoundation.org/
            </a>
        </p>
    </section>

    <p>
        <strong>
            "Apply for Scholarship to pursue your Nursing career at Bright Group
            of Institutions
            without any financial burden."
        </strong>
    </p>
</section>