                    </td>
                    <td>70</td>
                    <td>30</td>
                    <td>100</td>
                </tr>

                <tr>
                    <td>PAPER 2</td>
                    <td>
                        COMMUNITY MEDICINE, STATISTICS - 40 Marks<br>
